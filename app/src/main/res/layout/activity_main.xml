<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#0a0a0c">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FAKE LAG FF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#FF6B00"
        android:letterSpacing="0.1"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Simulador de lag para Free Fire"
        android:textSize="13sp"
        android:textColor="#6b6e7a"
        android:layout_marginBottom="48dp"/>

    <Button
        android:id="@+id/btn_main"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="ATIVAR FAKE LAG"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:backgroundTint="#FF6B00"
        android:letterSpacing="0.08"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Após ativar, abra o Free Fire.\nO painel flutuante aparecerá na tela."
        android:textSize="12sp"
        android:textColor="#6b6e7a"
        android:gravity="center"
        android:lineSpacingMultiplier="1.4"/>

</LinearLayout>
